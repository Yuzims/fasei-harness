{
  "name": "failure-aware-agent-harness",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Failure-Aware Software Engineering Investigation Harness: independent verification of agent claims over GitHub issues.",
  "type": "module",
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "api": "tsx watch src/server/listen.ts",
    "web": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build",
    "mainline": "tsx examples/mainline.ts",
    "benchmark": "tsx examples/benchmark.ts",
    "fasei-benchmark": "tsx examples/fasei-benchmark.ts",
    "ablation": "tsx examples/ablation.ts",
    "live": "tsx examples/live.ts",
    "capture-reports": "tsx scripts/capture-reports.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "demo:basic": "tsx examples/basic-run.ts",
    "demo:premature": "tsx examples/premature-completion.ts",
    "report": "tsx examples/mainline.ts",
    "build": "tsc && npm --prefix web run build",
    "start": "tsx src/server/listen.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.4",
    "hono": "^4.9.8"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0"
  }
}
