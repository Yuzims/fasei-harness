# 工作台：有 OPENAI_API_KEY 就走真模型。评测注入永远用脚本。
# AGENT_MODEL=mock 可强制规则 Agent
# AGENT_MODEL=openai 则必须有 Key
AGENT_MODEL=

OPENAI_API_KEY=

# 阿里云百炼（国内默认）
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_MODEL=qwen-plus

# 可选。匿名 GitHub 只有 60 次/小时；打满后填 PAT
GITHUB_TOKEN=

# 可选。本机无法直连 GitHub / 模型服务时，填代理的 HTTP 混合端口
# （如 Clash 的 http://127.0.0.1:7897）。后端已自动开启 NODE_USE_ENV_PROXY，
# Node >= 24 的 fetch 会走该代理；不填则保持直连。
# 注意：NO_PROXY 里 "localhost" 不能排在域名条目之前（Node 24 解析缺陷），
# 国内可直连的模型域名务必列出来。
HTTPS_PROXY=
NO_PROXY=127.0.0.1,dashscope.aliyuncs.com
